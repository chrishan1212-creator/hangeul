{
  "name": "hangeul-speech-play",
  "version": "1.0.0",
  "private": true,
  "description": "아이를 위한 한글 말하기 놀이 - Web Speech API 기반 한글 학습 PWA",
  "scripts": {
    "dev": "npm run audio:manifest && next dev",
    "prebuild": "npm run audio:manifest",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "audio:manifest": "node scripts/gen-audio-manifest.mjs",
    "audio:list": "node scripts/list-audio.mjs",
    "audio:tts": "node scripts/gen-tts.mjs",
    "build:toss": "TOSS_BUILD=1 next build && ait build",
    "deploy:toss": "ait deploy"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@apps-in-toss/devtools": "^3.0.4",
    "@apps-in-toss/web-framework": "^3.0.4",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "esbuild": "0.23.1",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
